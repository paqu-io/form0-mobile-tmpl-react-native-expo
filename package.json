{
  "name": "form0-mobile-tmpl-react-native-expo",
  "private": true,
  "version": "0.0.0",
  "description": "React Native + Expo template for form0 ecosystem.",
  "keywords": [
    "form0",
    "paqu-io",
    "schema-driven-forms",
    "json-schema",
    "template",
    "react-native",
    "expo",
    "mobile-forms",
    "offline-first"
  ],
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "license": "MIT",
  "scripts": {
    "start": "npm run generate-images && expo start",
    "android": "npm run generate-images && expo start --android",
    "ios": "npm run generate-images && expo start --ios",
    "web": "npm run generate-images && expo start --web",
    "generate-images": "node scripts/generate-image-registry.js",
    "check:generated": "node scripts/generate-image-registry.js --check",
    "check:expo": "expo install --check",
    "check:bundle": "expo export --platform all --output-dir dist",
    "security:audit:prod": "node scripts/audit-dependencies.mjs",
    "security:audit:prod:raw": "npm audit --omit=dev --omit=peer --audit-level=high",
    "security:audit:policy:test": "node --test scripts/audit-dependencies.test.mjs",
    "check": "npm run check:generated && npm run check:expo && npm run check:bundle"
  },
  "dependencies": {
    "@react-native/virtualized-lists": "0.88.0",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-font": "~58.0.9",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "form0-core": "^0.5.1",
    "form0-react-native": "^0.5.0",
    "lucide-react-native": "^0.511.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  }
}
