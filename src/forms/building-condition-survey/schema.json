          "value": "draft",
          "label": "Draft",
          "color": "#64748b"
        },
        {
          "value": "review",
          "label": "Ready for review",
          "color": "#d97706"
        },
        {
          "value": "complete",
          "label": "Reviewed",
          "color": "#15803d"
        }
      ]
