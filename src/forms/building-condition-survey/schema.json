      "visible": true,
      "visible_conditions": null,
      "read_only": true,
      "read_only_conditions": null,
      "elements": ["building_ref", "building_name"]
    },
    "events": {
      "code": "ON('change', 'overall_condition', function () {\n  if (CHOICEVALUE($overall_condition) === 'urgent') {\n    ALERT('Urgent follow-up', 'Describe the observation and record the next action and a follow-up contact.');\n  }\n});\n\nON('change', 'copy_assessor', function () {\n  if (CHOICEVALUE($copy_assessor) === 'yes' && $assessor) {\n    SETVALUE('follow_up_contact', $assessor);\n  }\n});\n\nON('validate-record', function () {\n  if ($follow_up_on && $inspection_on && DAYS($follow_up_on, $inspection_on) < 0) {\n    INVALID('The follow-up date cannot be before the inspection date.');\n  }\n});\n\nON('change', 'finding_priority', function () {\n  if (CHOICEVALUE($finding_priority) === 'urgent') {\n    ALERT('Document the next action', 'Record what should happen next for this observation.');\n  }\n});\n\nON('validate-repeatable', 'findings', function () {\n  if (CHOICEVALUE($finding_priority) === 'urgent' && (!$next_action || !$next_action.trim())) {\n    INVALID('Record a next action for this urgent observation.');\n  }\n});"
    },
