      "read_only": true,
      "read_only_conditions": null,
      "elements": ["borrower_name", "checkout_on"]
    },
    "events": {
      "code": "ON('change', 'copy_borrower', function () {\n  if (CHOICEVALUE($copy_borrower) === 'yes' && $borrower_name) {\n    SETVALUE('collection_contact', $borrower_name);\n  }\n});\n\nON('change', 'item_condition', function () {\n  if (CHOICEVALUE($item_condition) === 'damaged') {\n    ALERT('Record existing damage', 'Describe the damage and add a photo before this item leaves.');\n  }\n});\n\nON('validate-record', function () {\n  if ($checkout_on && $expected_return_on && DAYS($expected_return_on, $checkout_on) < 0) {\n    INVALID('The expected return date cannot be before checkout.');\n  }\n});\n\nON('validate-repeatable', 'equipment_items', function () {\n  if (CHOICEVALUE($item_condition) === 'damaged' && (!$damage_notes || !$damage_notes.trim())) {\n    INVALID('Describe the existing damage before saving this item.');\n  }\n});"
    },
